# LM Studio local server configuration
# 1. Open LM Studio -> Developer -> Start Server
# 2. Load your model (e.g. qwen3-vl-30b-a3b-instruct-mlx)
# 3. Copy your API token from LM Studio (or disable auth for localhost)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_API_TOKEN=lm-studio
LM_STUDIO_MODEL=qwen3-vl-30b-a3b-instruct-mlx
